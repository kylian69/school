{
  "name": "@scolaly/db",
  "version": "0.0.0",
  "private": true,
  "description": "Schéma Drizzle, migrations, politiques RLS et données de démonstration.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate && git diff --exit-code -- migrations && test -z \"$(git status --porcelain -- migrations)\"",
    "db:migrate": "node dist/cli/migrate.js",
    "db:bootstrap": "node dist/cli/bootstrap.js"
  },
  "devDependencies": {
    "@scolaly/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "uuid": "catalog:"
  }
}
