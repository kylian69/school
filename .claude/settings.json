{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node --env-file=.env *)",
      "Bash(node dist/cli/openapi.js)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git rebase origin/*)",
      "Bash(git rebase --continue)",
      "Bash(git stash*)",
      "Bash(git push -u origin claude/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Read(./apps/api/openapi.json)",
      "Read(./packages/db/migrations/meta/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && sh \"$CLAUDE_PROJECT_DIR/infra/claude/preparer-conteneur.sh\" || true",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
