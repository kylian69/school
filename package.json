{
  "name": "scolaly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run build lint typecheck test && pnpm deps:check",
    "deps:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "dev:up": "sh infra/compose/dev-up.sh",
    "dev:down": "docker compose -f infra/compose/compose.dev.yml down",
    "demo:seed": "pnpm --filter @scolaly/api build && pnpm --filter @scolaly/api demo:seed"
  },
  "devDependencies": {
    "dependency-cruiser": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
