{
  "name": "@scolaly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently --raw --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi": "node dist/cli/openapi.js",
    "demo:seed": "node --env-file-if-exists=../../.env dist/cli/seed-demo.js",
    "demo:seance": "node --env-file-if-exists=../../.env dist/cli/seance-demo.js",
    "charge:preparer": "node --env-file-if-exists=../../.env dist/cli/charge-preparer.js",
    "charge:verifier": "node --env-file-if-exists=../../.env dist/cli/charge-verifier.js",
    "plateforme:super-admin": "node --env-file-if-exists=../../.env dist/cli/super-administrateur.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fastify/helmet": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@scolaly/contracts": "workspace:*",
    "@scolaly/db": "workspace:*",
    "@scolaly/domain": "workspace:*",
    "@scolaly/referentials": "workspace:*",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fflate": "catalog:",
    "ioredis": "catalog:",
    "read-excel-file": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@scolaly/config": "workspace:*",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
